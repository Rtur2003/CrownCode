# CrownCode Platform - Environment Configuration
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ===========================================
# PLATFORM CONFIGURATION
# ===========================================

NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# Platform URLs
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CrownCode
NEXT_PUBLIC_APP_VERSION=1.0.0

# Deployment mode: static (Netlify) or server (Node runtime)
DEPLOYMENT_TARGET=static

# ===========================================
# BACKEND API (FastAPI on HuggingFace Spaces)
# ===========================================

# Local development
NEXT_PUBLIC_API_URL=http://localhost:7860
NEXT_PUBLIC_API_TIMEOUT=30000

# Production (HuggingFace Spaces)
# NEXT_PUBLIC_API_URL=https://your-space-name.hf.space

# ===========================================
# AI MUSIC DETECTION
# ===========================================

AI_MODEL_PATH=/models/wav2vec2
MUSIC_AI_API_URL=http://localhost:8001
SES_ANALIZI_API_URL=http://localhost:8002
CROWNCODE_API_TIMEOUT_SEC=30
CROWNCODE_CORS_ORIGINS=http://localhost:3000
SES_ANALIZI_THRESHOLD=0.5

# ===========================================
# EXTERNAL APIS
# ===========================================

# Spotify API
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://your-domain.com/ai-music-detection

# YouTube OAuth (for Crown Commend backend)
YOUTUBE_OAUTH_CLIENT_ID=your-youtube-client-id
YOUTUBE_OAUTH_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_OAUTH_REDIRECT_URI=https://your-domain.com/ai-music-detection

# Gemini API (for Crown Commend backend)
GEMINI_API_KEY=your-gemini-api-key

# GitHub Token (for profile data)
GITHUB_TOKEN=your-github-token

# ===========================================
# FILE UPLOAD
# ===========================================

MAX_FILE_SIZE=104857600
ALLOWED_AUDIO_FORMATS=mp3,wav,flac,m4a
UPLOAD_DIR=/tmp/uploads

# ===========================================
# DEPLOYMENT (Netlify)
# ===========================================

NETLIFY_AUTH_TOKEN=your-netlify-token
NETLIFY_SITE_ID=your-netlify-site-id

# ===========================================
# MONITORING & ANALYTICS (optional)
# ===========================================

NEXT_PUBLIC_GA_TRACKING_ID=GA_MEASUREMENT_ID
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# ===========================================
# FEATURE FLAGS
# ===========================================

FEATURE_AI_MUSIC_DETECTION=true
FEATURE_DATA_MANIPULATION=false

# Fortune counter requires server mode (not available in static export)
NEXT_PUBLIC_ENABLE_FORTUNE_COUNTER=false

# ===========================================
# DEVELOPMENT
# ===========================================

DEBUG=false
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Development server port
DEV_PLATFORM_PORT=3000

# ===========================================
# PRODUCTION OVERRIDES
# ===========================================

# NEXT_PUBLIC_PLATFORM_URL=https://hasanarthuraltuntas.xyz
# NEXT_PUBLIC_API_URL=https://your-space-name.hf.space
