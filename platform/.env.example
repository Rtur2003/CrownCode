# =========================================================================
# CROWNCODE PLATFORM - ENVIRONMENT VARIABLES
# =========================================================================
# Copy to .env.local for local development. Never commit .env.local.
#
# Only variables the platform code actually reads are listed here
# (checked with `git grep "process.env"`). Anything NEXT_PUBLIC_* is baked
# into the browser bundle: never put a secret in one. The site's canonical
# URL is SITE_URL in config/site.ts, not an environment variable.
# =========================================================================

# ── ACTIVE ───────────────────────────────────────────────────────────────

# AURIS backend (the Hugging Face Space). Unset: the Space URL in
# config/api.ts is used; Crown Commend, Crown Dreams, Creator Studio and
# ML Toolkit show "not configured" without it.
# Local backend: http://localhost:7860
NEXT_PUBLIC_API_URL=

# Shown by /api/health and /api/version
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── OPTIONAL ─────────────────────────────────────────────────────────────

# Crown Fortune's global "readings today" counter (the page works without it)
NEXT_PUBLIC_ENABLE_FORTUNE_COUNTER=false

# Server-side switches. "false" turns the endpoint into a no-op.
FEATURE_WEB_VITALS=true
FEATURE_CLIENT_ERRORS=true
# Fraction of Web Vitals reports kept, 0 to 1
VITALS_SAMPLE_RATE=1

# Reported by /api/version
FEATURE_AI_ANALYSIS=true
FEATURE_STREAMING_PLATFORMS=true
FEATURE_BATCH_PROCESSING=false

# Send the Content-Security-Policy as report-only (production builds), to
# watch for violations before enforcing it
CSP_REPORT_ONLY=false

# `npm run analyze` sets this itself
# ANALYZE=true

# Used by scripts/capture-atlas-reel.mjs when Playwright is installed globally
# PLAYWRIGHT_MODULE=
