# ==========================================
# CrownCode Platform (Next.js) - .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
build/
dist/

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/

# Environment
.env
.env.*
!.env.example
!.env.local.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Temporary
tmp/
temp/
*.tmp

# Vercel/Netlify
.vercel/
.netlify/

# Cloudflare (OpenNext / Wrangler)
.open-next/
.wrangler/
cloudflare-env.d.ts

# Bundle analysis
bundle-report.html
stats.json

# TypeScript
*.tsbuildinfo

# Storybook
storybook-static/

# PWA: public/sw.js is hand-written (registered in pages/_app.tsx, covered by
# __tests__/config/security-headers.test.ts) and must stay tracked. Only
# generated workbox bundles are ignored.
public/workbox-*.js

# Wrangler local secrets and state
.dev.vars
.dev.vars.*
!.dev.vars.example

# Lighthouse and DevTools trace output
.lighthouseci/
lighthouse-*.json
lighthouse-*.html
*.report.html
*.report.json
*.trace.json
*.trace.json.gz

# Reel output (frames, video, sound, events, stills): made by scripts/capture-*.py|mjs,
# scripts/edit-*.py and scripts/generate-*-reel-sound.py, rebuilt on demand, never tracked.
assets-src/video/**/frames/
assets-src/video/**/*.mp4
assets-src/video/**/*.wav
assets-src/video/**/*.jpg
assets-src/video/**/*.png
assets-src/video/auris/
assets-src/video/atlas/
# Raw footage from capture-atlas-shots.py and capture-page-tour.py (all-intra, large)
assets-src/video/shots/
# Music promos: covers, previews, fonts and renders for the music site (edit-release-promo.py)
assets-src/video/music/
