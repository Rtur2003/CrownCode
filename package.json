{
  "name": "crowncode-workspace",
  "version": "1.0.0",
  "description": "CrownCode workspace orchestration scripts for platform development",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:platform",
    "dev:platform": "npm --prefix platform run dev",
    "build": "npm run build:platform",
    "build:platform": "npm --prefix platform run build",
    "test": "npm run test:platform",
    "test:platform": "npm --prefix platform run test --if-present",
    "test:all": "npm run test",
    "lint": "npm run lint:platform",
    "lint:platform": "npm --prefix platform run lint",
    "type-check": "npm run type-check:platform",
    "type-check:platform": "npm --prefix platform run type-check",
    "deploy:staging": "npm run build && npm run deploy:staging:platform",
    "deploy:production": "npm run build && npm run deploy:production:platform",
    "deploy:staging:platform": "cd platform && vercel --target staging",
    "deploy:production:platform": "cd platform && vercel --prod",
    "setup": "npm install && npm run setup:platform",
    "setup:platform": "npm --prefix platform install",
    "clean": "npm run clean:platform",
    "clean:platform": "npm --prefix platform run clean --if-present"
  },
  "keywords": [
    "crowncode",
    "workspace",
    "platform",
    "ai",
    "music",
    "detection",
    "data",
    "manipulation",
    "machine",
    "learning",
    "web",
    "application",
    "nextjs",
    "react",
    "typescript"
  ],
  "author": {
    "name": "Hasan Arthur Altuntaş",
    "email": "contact@hasanarthuraltuntas.xyz",
    "url": "https://hasanarthuraltuntas.xyz"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rtur2003/CrownCode.git"
  },
  "bugs": {
    "url": "https://github.com/Rtur2003/CrownCode/issues"
  },
  "homepage": "https://hasanarthuraltuntas.xyz",
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10.9.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "platform"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
